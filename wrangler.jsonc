{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Venu & Vena website. Cloudflare Workers Builds runs `npx wrangler deploy` on every
  // merge into main; wrangler runs the build below first, so no build command is set in the
  // dashboard. Nothing is ever deployed from a cloud session.
  "name": "venuandvena",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  // The site's addresses, on the "Venu and Vena" Cloudflare account. www is sent on to the
  // bare address by the Worker itself.
  "routes": [
    { "pattern": "venuandvena.com", "custom_domain": true },
    { "pattern": "www.venuandvena.com", "custom_domain": true }
  ],
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Pages go through the Worker (so www.venuandvena.com/<page> is sent on to the bare
    // address); styles, scripts, pictures and fonts are served straight from the assets.
    "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/img/*", "!/fonts/*", "!/studio/*.css", "!/favicon.png", "!/robots.txt"]
  },
  // Feedback answers. No database_id: wrangler creates the database on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "venuandvena-feedback" }],
  // Daily at 03:17 UTC: delete answers older than 12 months.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false }
}
